{
  "name": "lingua-srs-sync",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker (D1) that syncs LinguaSRS between devices. See docs/sync.md.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply DB --remote",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.2"
  }
}
